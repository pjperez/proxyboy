{
  "name": "proxyboy",
  "version": "1.0.0",
  "description": "ProxyBoy - Agentic HTTP/HTTPS Debugging Proxy for Windows",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge make",
    "package": "electron-forge package",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "proxy",
    "http",
    "https",
    "debugging",
    "electron",
    "copilot"
  ],
  "author": "Pedro Perez",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/pjperez/proxyboy.git"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.1.32",
    "@monaco-editor/react": "^4.7.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "electron-squirrel-startup": "^1.0.1",
    "http-mitm-proxy": "^1.1.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "pako": "^2.1.0",
    "protobufjs": "^8.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.18.3",
    "remark-gfm": "^4.0.1",
    "socks-proxy-agent": "^7.0.0",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.0.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-static-copy": "^3.3.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "glob": "^13.0.0",
    "rimraf": "^5.0.10",
    "tar": "^7.5.2",
    "@electron/rebuild": "^4.0.1",
    "electron-winstaller": "^5.4.4",
    "boolean": "file:packages/shims/boolean",
    "lodash.get": "file:packages/shims/lodash.get",
    "uuid": "^11.1.0",
    "brace-expansion": "file:packages/vendor/brace-expansion",
    "tmp": "0.2.7",
    "fast-uri": "file:packages/vendor/fast-uri",
    "dompurify": "^3.4.12",
    "vscode-jsonrpc": "file:packages/vendor/vscode-jsonrpc"
  },
  "vitest": {
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/packages/**",
      "**/cypress/**",
      "**/.{idea,git,cache,output,temp}/**"
